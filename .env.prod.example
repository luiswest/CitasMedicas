# ==========================================================================
#  Variables para docker-compose.prod.yml  ->  copiar como .env.prod
#  NO subir .env.prod al repositorio.
#  Generar valores aleatorios:  openssl rand -hex 32
# ==========================================================================

# Llave para firmar los JWT (capa de negocio)
JWT_KEY=cambie_esto_por_64_caracteres_hex_generados_con_openssl

# Llave compartida negocio <-> datos (solo letras, números, _ y -)
INTERNAL_KEY=cambie_esto_por_otra_llave_hex

# Duración del token de acceso en segundos
JWT_TTL=3600

# Dominio público. Ejemplos:
#   citas.midominio.com
#   152-70-12-34.sslip.io     (IP pública con guiones; no requiere comprar dominio)
#   (vacío)                   -> solo HTTP en el puerto 80
DOMAIN=

# Orígenes CORS para la app móvil (Capacitor)
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,capacitor://localhost
